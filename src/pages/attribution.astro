---
import Base from '../layouts/Base.astro';
import GuideIndex from '../components/GuideIndex.astro';
import { REPO, ZENODO_DOI, ZENODO_DOI_URL } from '../consts.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const toc = [["source", "Source code"], ["credits", "Credits and licenses"], ["citation", "Citation"]];
---
<Base title="Open source — Embodent" description="Explore the Embodent source project, licenses and published Orcha citation.">
<div class="wrap guide-header">
<h1>Built in the open.</h1>
<p class="intro">Embodent is the app name. The source project, commands and published citation keep their existing Orcha names.</p>
<details class="toc-mobile">
<summary>On this page</summary>
<GuideIndex links={toc} />
</details>
</div>
<div class="wrap guide-grid">
<aside class="toc" aria-label="On this page">
<strong>Open source</strong>
<GuideIndex links={toc} />
</aside>
<article class="guide-content">
<section class="guide-section" id="source">
<h2>Explore the source</h2>
<p>Read the code, report an issue or contribute to the project.</p>
<div class="actions" style="margin-top:24px">
<a class="button primary" href={REPO}>Browse on GitHub</a>
<a class="button" href={`${REPO}/blob/main/LICENSE`}>Read the MIT license</a>
</div>
</section>
<section class="guide-section" id="credits">
<h2>Credits and licenses</h2>
<dl class="legal-list">
<div>
<dt>Embodent / Orcha</dt>
<dd>Project by Kedar Haldankar. See the source repository for project credits and the license.</dd>
</div>
<div>
<dt>Inter</dt>
<dd>The interface uses Inter by Rasmus Andersson, licensed under the SIL Open Font License. <a href={`${base}brand/OFL-inter.txt`}>Read the font license</a>.</dd>
</div>
<div>
<dt>Other open-source dependencies</dt>
<dd>The source repository includes dependency manifests and license information. This page does not claim to be a complete dependency inventory.</dd>
</div>
</dl>
</section>
<section class="guide-section" id="citation">
<h2>Cite the project</h2>
<p>The published citation uses the Orcha name. Keep that title when citing it.</p>
<div class="code-block">
<div class="code-label">
<span>Plain citation</span>
<button type="button" class="copy enhanced-only" data-copy="citation-code" aria-label="Copy project citation">Copy</button>
</div>
<pre id="citation-code">Haldankar, K. (2026). Orcha: Human-authoritative multi-agent orchestration. Zenodo. {ZENODO_DOI_URL}</pre>
<p class="copy-result" role="status" aria-live="polite">
</p>
</div>
<a class="text-link" href={ZENODO_DOI_URL}>View the permanent archive</a>
</section>
<details class="guide-detail">
<summary>BibTeX citation</summary>
<pre>{`@software{haldankar_orcha_2026,
  author    = {Haldankar, Kedar},
  title     = {Orcha: Human-authoritative multi-agent orchestration},
  year      = {2026},
  publisher = {Zenodo},
  doi       = {${ZENODO_DOI}},
  url       = {${ZENODO_DOI_URL}}
}`}</pre>
</details>
</article>
</div>
</Base>
