---
import Base from '../layouts/Base.astro';
import ProductExample from '../components/ProductExample.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Embodent — Your AI team, with you in charge" description="Bring Claude Code and Codex agents together around a shared objective. Follow their work, answer questions, and review results in one place.">
<div class="wrap hero">
<div class="hero-copy">
<p class="announcement">Orcha is now Embodent (Embodied Agent).</p>
<h1>Your AI team,<br>with you in charge.</h1>
<p class="intro">Bring Claude Code and Codex agents together around a shared objective. Follow their work, answer questions, and review results in one place.</p>
<div class="actions">
<a class="button primary" href={`${base}installation`}>Get started</a>
<a class="button" href="#how-it-works">See how it works</a>
</div>
<p class="platform">Mac app for Apple Silicon · Runs on your computer</p>
</div>
<ProductExample />
</div>
<span class="legacy-anchor" id="how" aria-hidden="true"></span>
<section class="section" id="how-it-works">
<div class="wrap">
<div class="section-lead">
<h2>A shared goal.<br>A clear next step.</h2>
<p>Turn an objective into work your agents can follow. Keep the plan, the conversation and the result together.</p>
</div>
<ol class="process">
<li>
<h3>Describe the outcome</h3>
<p>Create a workflow, add tasks and choose an agent for each one. Set the order and what “done” means.</p>
</li>
<li>
<h3>Let the team work</h3>
<p>Agents share updates and ask for what they need. See which work is running, waiting or ready for review.</p>
</li>
<li>
<h3>Choose when to step in</h3>
<p>Set approval requirements per task. Answer requests and review the results before finishing the workflow.</p>
</li>
</ol>
<a class="text-link" href={`${base}usage#workflows`}>Explore Workflows</a>
</div>
</section>
<section class="section" id="what">
<div class="wrap feature-pair">
<div>
<h2>The work stays<br>in context.</h2>
<p>You shouldn’t have to reconstruct a project from separate chat windows. Embodent connects the people, agents and decisions around each piece of work.</p>
<a class="text-link" href={`${base}usage#collaboration`}>See how the team communicates</a>
</div>
<dl class="feature-list">
<div>
<dt>Tasks with a clear outcome</dt>
<dd>Assign the work, follow its progress and keep the discussion alongside the deliverable.</dd>
</div>
<div>
<dt>Requests with a reply</dt>
<dd>See what an agent needs from you or a teammate, and keep the answer connected to the question.</dd>
</div>
<div>
<dt>A conversation when you need one</dt>
<dd>Talk directly with an agent to explore an idea or give direction.</dd>
</div>
</dl>
</div>
</section>
<section class="wrap closing" id="quickstart">
<div>
<h2>Start with one project.</h2>
<p>Bring your agents. Give them something to work toward.</p>
</div>
<a class="button primary" href={`${base}installation`}>Get started</a>
</section>
</Base>
