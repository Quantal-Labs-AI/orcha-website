---
import Base from '../layouts/Base.astro';
import { RELEASES_API, REPO } from '../consts.js';
---
<Base title="Download statistics — Embodent" description="Public Mac app download counts from GitHub Releases.">
  <div class="wrap guide-header">
    <h1>Mac app downloads.</h1>
    <p class="intro">Public download counts from GitHub Releases. These count files downloaded, not people or completed installations.</p>
  </div>
  <div class="wrap stats-content">
    <section class="download-panel" aria-labelledby="downloads-heading">
      <h2 id="downloads-heading">Release downloads</h2>
      <p class="download-count" data-mac-total>—</p>
      <p data-mac-meta role="status">Enable JavaScript to load the current counts, or view releases below.</p>
      <a class="text-link" href={`${REPO}/releases`}>View releases on GitHub</a>
    </section>
    <p class="muted">Includes Mac DMG and ZIP files from published releases returned by GitHub (up to 30 recent releases). Repeat downloads are included; checksums and other files are excluded.</p>
  </div>
</Base>
<style>
  .stats-content { padding-bottom: 80px; }
  .download-panel { max-width: 780px; margin-top: 0; }
  .download-panel h2 { font-size: 28px; }
  .download-count { font-size: 48px; font-weight: 600; color: var(--text); }
</style>
<script define:vars={{ RELEASES_API }}>
  const value = document.querySelector('[data-mac-total]');
  const message = document.querySelector('[data-mac-meta]');
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 10000);
  message.textContent = 'Loading from GitHub…';
  async function loadDownloads() {
    try {
      const response = await fetch(RELEASES_API, {
        headers: { Accept: 'application/vnd.github+json' }, signal: controller.signal,
      });
      if (!response.ok) throw new Error('Release information unavailable');
      const releases = await response.json();
      if (!Array.isArray(releases)) throw new Error('Unexpected release information');
      let total = 0;
      let count = 0;
      for (const release of releases) {
        if (release.draft || release.prerelease || !release.tag_name?.startsWith('v')) continue;
        const assets = (release.assets || []).filter((asset) =>
          /^(?:Orcha|Embodent)-.*(?:\.dmg|-mac\.zip)$/i.test(asset.name)
        );
        if (!assets.length) continue;
        total += assets.reduce((sum, asset) => sum + (Number(asset.download_count) || 0), 0);
        count++;
      }
      value.textContent = total.toLocaleString('en-US');
      message.textContent = count
        ? `Across ${count} published Mac release${count === 1 ? '' : 's'} returned by GitHub.`
        : 'No Mac download files were found in the recent releases.';
    } catch {
      value.textContent = '—';
      message.textContent = 'Download counts are unavailable right now. Try again later or view releases on GitHub.';
    } finally { clearTimeout(timeout); }
  }
  loadDownloads();
</script>
