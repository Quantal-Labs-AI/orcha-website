---
import Base from '../layouts/Base.astro';
import { BREW_INSTALL, BREW_TAP, MAC_DMG_URL, APP_VERSION } from '../consts.js';
const base = import.meta.env.BASE_URL;
---
<Base title="Installation Guide — Orcha" description="Install Orcha on your Mac — no Docker, no database to set up. Orcha runs quietly in the background and keeps your project's data in one file.">
  {/* TODO(#258): DRAFT — this page describes the upcoming no-Docker release. Do not merge to main (main deploys straight to openorcha.io) until that release ships. */}
  <!-- INTRO -->
  <section class="install-intro">
    <div class="wrap">
      <h1>Installation Guide</h1>
      <p class="section-sub">
        Orcha now runs as ordinary background programs on your Mac — <strong>no Docker, no
        database server</strong>, nothing extra to keep open. Everything Orcha knows about a project
        lives in one file inside that project: <code class="inline">&lt;project&gt;/.orcha/orcha.db</code>.
      </p>
      <p class="section-sub">
        Most people should use the <a href="#mac">Mac app</a>. Prefer the command line, or on
        Linux? Use <a href="#cli">uv</a> or <a href="#brew">Homebrew</a> instead.
      </p>
    </div>
  </section>

  <!-- WHAT YOU NEED -->
  <section id="needs">
    <div class="wrap">
      <h2 class="section-title">What you need</h2>
      <p class="section-sub">Very little — and no Docker.</p>
      <p class="note">
        <strong>An AI coding agent, signed in</strong> — Claude&nbsp;Code <em>or</em> Codex. Orcha
        uses whichever you have. Get Claude&nbsp;Code from <a href="https://claude.ai">claude.ai</a>
        or Codex from <a href="https://chatgpt.com/codex">chatgpt.com/codex</a>, then sign in once.
      </p>
      <p class="note">
        <strong>git</strong> <em>(optional)</em> — only needed if your project lives on GitHub.
        Most Macs already have it.
      </p>
      <p class="note">
        <strong>That’s it.</strong> You don’t need to install Python, Docker or a database —
        <a href="#cli">uv</a> takes care of Python for you. The Mac app needs a Mac with
        Apple&nbsp;Silicon; the command line works on macOS and Linux.
      </p>
    </div>
  </section>

  <!-- OPTION A — MAC APP (RECOMMENDED) -->
  <section id="mac">
    <div class="wrap">
      <h2 class="section-title">Option A — the Mac app <span class="badge-req">Recommended</span></h2>
      <p class="section-sub">
        The easiest way in. Download it, open the .dmg, and drag Orcha into your Applications
        folder. No Terminal needed.
      </p>
      {/* TODO(#258): bump APP_VERSION in consts.js to the first no-Docker release before publishing — the current DMG is the Docker-era universal build. */}
      <div class="cta-row">
        <a class="btn btn-primary" href={MAC_DMG_URL}>Download Orcha {APP_VERSION} (.dmg)</a>
      </div>
      <p class="note">
        <strong>Signed &amp; notarized by Apple.</strong> It opens straight away — no security
        warnings to click through.
      </p>
      {/* TODO(#258): bundled runtime ships with plan PR 16 (desktop sidecar) */}
      <p class="note">
        <strong>Everything Orcha needs is built in.</strong> The app carries its own copy of the
        Orcha engine, so there’s nothing else to install first.
      </p>

      <h3 class="prereq-h">What happens when you open it</h3>
      <p class="section-sub">
        A short setup in a single window. You don’t type any commands — you just click along.
      </p>

      <div class="steps onboard-steps">
        <div class="step">
          <div class="num">1</div>
          <h4>Open Orcha</h4>
          <p>Launch Orcha from your Applications folder.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h4>Pick a project folder</h4>
          <p>Choose an existing project folder, or create a new one — right from the app.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h4>Sign in to Claude Code</h4>
          <p>
            If you haven’t already, sign in to Claude&nbsp;Code (or Codex) once. Orcha uses
            whichever you have.
          </p>
        </div>
        <div class="step">
          <div class="num">4</div>
          <h4>You’re running</h4>
          <p>
            Orcha sets the project up and keeps it running in the background — even after you
            close the app or restart your Mac. You’re ready to bring in agents.
          </p>
        </div>
      </div>

      <div class="cta-row">
        <a class="btn btn-ghost" href={base}>Back home</a>
      </div>
    </div>
  </section>

  <!-- OPTION B — COMMAND LINE WITH UV -->
  <section id="cli">
    <div class="wrap">
      <h2 class="section-title">Option B — the command line, with uv <span class="badge-opt">macOS &amp; Linux</span></h2>
      <p class="section-sub">
        Prefer the Terminal, or on Linux? <strong>uv</strong> is a small, free installer that
        fetches the right version of Python for you, so you don’t have to. Open the
        <strong>Terminal</strong> app (⌘&nbsp;Space, type “Terminal”) and run these three lines:
      </p>
      {/* TODO(#258): needs orcha-cli published to PyPI (plan PR 13, owner question Q-H) */}
      <code class="code"><span class="c"># 1. install uv</span>
curl -LsSf https://astral.sh/uv/install.sh | sh

<span class="c"># 2. install the Orcha command-line tool</span>
uv tool install orcha-cli

<span class="c"># 3. check it worked</span>
orcha --version</code>
      <p class="note">
        If <code class="inline">orcha</code> isn’t found after step 2, open a fresh Terminal window
        and try again — uv adds it to your path the first time.
      </p>
      <p class="note">
        <strong>Updating:</strong> run <code class="inline">uv tool upgrade orcha-cli</code> any time.
      </p>
    </div>
  </section>

  <!-- OPTION C — HOMEBREW -->
  <section id="brew">
    <div class="wrap">
      <h2 class="section-title">Option C — Homebrew <span class="badge-opt">Still supported</span></h2>
      <p class="section-sub">
        Already use <a href="https://brew.sh">Homebrew</a>? Orcha installs from it just like before:
      </p>
      <code class="code"><span class="c"># install the CLI with Homebrew</span>
{BREW_INSTALL}</code>
      <p class="note">
        <strong>Updating:</strong> run <code class="inline">brew upgrade orcha</code> to get the
        latest version.
      </p>
    </div>
  </section>

  <!-- FIRST RUN -->
  <section id="first-run">
    <div class="wrap">
      <h2 class="section-title">First run</h2>
      <p class="section-sub">
        Using the command line (Option B or C)? Go into your project’s folder and start Orcha
        there:
      </p>
      <code class="code"><span class="c"># go to your project</span>
cd ~/projects/your-project

<span class="c"># set up Orcha for this project and register yourself as the first human</span>
orcha init --objective "Ship the thing" --as YourName</code>
      {/* TODO(#258): init only defaults to native and installs the login service from plan PR 10; until then it defaults to Docker */}
      <p class="note">
        <strong>That’s the whole setup.</strong> <code class="inline">orcha init</code> starts the
        Orcha portal at <code class="inline">http://localhost:&lt;port&gt;</code> — it prints the exact
        address for you — and installs a small login service so Orcha keeps running after you close
        the Terminal, and comes back on its own after a restart.
      </p>

      <h3 class="prereq-h">Handy commands</h3>
      <p class="section-sub">Run these inside your project folder.</p>
      {/* TODO(#258): orcha status/logs/down/up confirmed (plan PR 6); orcha doctor (R4) and orcha backup (S7) are not built yet */}
      <table class="cmd-table">
        <thead>
          <tr><th>Command</th><th>What it does</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code class="inline">orcha status</code></td>
            <td>Shows whether Orcha is running for this project, its web address, and where its data lives.</td>
          </tr>
          <tr>
            <td><code class="inline">orcha logs -f</code></td>
            <td>Shows what Orcha is doing, live. Handy if something looks stuck. Press Ctrl-C to stop watching.</td>
          </tr>
          <tr>
            <td><code class="inline">orcha doctor</code></td>
            <td>Checks everything Orcha needs, on one screen. <strong>Reporting a bug? Paste its output into your report.</strong></td>
          </tr>
          <tr>
            <td><code class="inline">orcha down</code> / <code class="inline">orcha up</code></td>
            <td>Stop Orcha for this project (your data is kept), and start it again.</td>
          </tr>
          <tr>
            <td><code class="inline">orcha backup</code></td>
            <td>Saves a copy of this project’s Orcha data into <code class="inline">.orcha/backups/</code>.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- MIGRATING FROM DOCKER -->
  <section id="migrate">
    <div class="wrap">
      <h2 class="section-title">Already using Orcha with Docker?</h2>
      <p class="section-sub">
        Bring your existing project across with one command, run once inside the project folder.
        Docker needs to be running this one time, so Orcha can copy your data out of it.
      </p>
      {/* TODO(#258): orcha migrate-runtime is plan PR 8 */}
      <code class="code"><span class="c"># move this project off Docker (one time)</span>
orcha migrate-runtime</code>
      <p class="note">
        <strong>Your old Docker data is kept, untouched.</strong> Nothing is deleted until you
        decide you’re happy — then, and only then, clean it up with
        <code class="inline">orcha migrate-runtime --purge-docker</code>. After that you can
        uninstall Docker if nothing else needs it.
      </p>
    </div>
  </section>

  <!-- RESET TO CLEAN SLATE -->
  <section id="reset">
    <div class="wrap">
      <h2 class="section-title">Resetting a project to a clean slate</h2>
      <p class="section-sub">
        If a project’s Orcha workspace gets into a bad state and you want to start completely
        fresh — without uninstalling anything — run this from the <strong>Terminal</strong>, inside
        the project folder:
      </p>
      <code class="code"><span class="c"># wipes this project’s Orcha workspace and re-initializes it from scratch</span>
orcha init --force --reset-data</code>
      <p class="note note-prereq">
        <strong>This is a destructive command.</strong> It permanently erases the Orcha workspace
        inside this project — every task, agent and bit of history Orcha was tracking — and rebuilds
        it empty. <strong>Your own project code and files are not touched</strong>; only Orcha’s own
        data for this project is wiped. There’s no undo (unless you made an
        <code class="inline">orcha backup</code> first), so only run it when you genuinely want to
        throw away this project’s Orcha history and begin again.
      </p>
    </div>
  </section>

  <!-- STOPPING / UNINSTALLING -->
  <section id="uninstall">
    <div class="wrap">
      <h2 class="section-title">Stopping or removing Orcha</h2>
      <p class="section-sub">
        Want to pause a project, or remove Orcha entirely? Run these from the
        <strong>Terminal</strong>, in this order — each step undoes a bit more.
      </p>

      <h3 class="prereq-h">1. Stop a project</h3>
      <p class="section-sub">
        Run this inside the project folder. Orcha stops, and your data is kept — run
        <code class="inline">orcha up</code> when you want it back.
      </p>
      <code class="code"><span class="c"># stops Orcha for this project (keeps your data)</span>
orcha down</code>
      <p class="note note-prereq">
        <strong>Want to erase that project’s Orcha data too?</strong> Use
        <code class="inline">orcha down -v</code> instead. It deletes
        <code class="inline">.orcha/orcha.db</code> — the project’s tasks, agents and history. Your
        own code and files are untouched.
      </p>

      <h3 class="prereq-h">2. Remove the login service</h3>
      <p class="section-sub">
        Stops Orcha from starting up again for this project when you log in:
      </p>
      {/* TODO(#258): orcha service uninstall is plan PR 10 (cli_service.py) */}
      <code class="code"><span class="c"># removes this project’s background login service</span>
orcha service uninstall</code>

      <h3 class="prereq-h">3. Uninstall Orcha itself</h3>
      <p class="section-sub">Use the line that matches how you installed it:</p>
      <code class="code"><span class="c"># installed with uv</span>
uv tool uninstall orcha-cli

<span class="c"># …or installed with Homebrew (removes the tool, then the Orcha tap)</span>
brew uninstall orcha
brew untap {BREW_TAP}</code>
      <p class="note">
        Using the Mac app? Drag <strong>Orcha</strong> from Applications to the Trash. Changed your
        mind? You can reinstall any time.
      </p>
    </div>
  </section>
</Base>

<style>
  .cmd-table {
    width: 100%;
    max-width: 820px;
    border-collapse: collapse;
    margin: 8px 0 12px;
    font-size: 0.95rem;
  }
  .cmd-table th,
  .cmd-table td {
    text-align: left;
    vertical-align: top;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .cmd-table th {
    color: var(--foam);
    font-weight: 600;
  }
  .cmd-table td {
    color: var(--muted);
  }
  .cmd-table strong {
    color: var(--foam);
  }
  #needs .note a,
  #cli .note a,
  #brew .section-sub a,
  .install-intro a {
    color: var(--cyan-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
